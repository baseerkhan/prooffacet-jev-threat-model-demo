[Unit]
Description=ProofFacet Jev threat-triage experiment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prooffacet
Group=prooffacet
WorkingDirectory=/opt/prooffacet-jev/current
EnvironmentFile=/etc/prooffacet-jev/prooffacet-jev.env
Environment=HOST=127.0.0.1
Environment=PORT=8790
Environment=PROOFFACET_DATA_DIR=/var/lib/prooffacet-jev
Environment=PROOFFACET_MAX_RECORDS=250
ExecStart=/usr/local/bin/node /opt/prooffacet-jev/current/dist/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0027
MemoryHigh=128M
MemoryMax=200M
CPUQuota=40%
TasksMax=48
LimitNPROC=48
LimitNOFILE=2048
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prooffacet-jev
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
